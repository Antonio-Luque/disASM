E41A CD FC 00    4 461 Realloc_52          call    StrWrChar-START
E41D 78          4 463 ld      a, b                        ; Get offset into instruction
E41E 3C          4 464 inc     a                           ; Increment to give instruction length
E41F FD E1       4 466 pop     iy                          ; Restore system variables pointer
E421 FB          4 467 ei                                  ; Enable interrupts
