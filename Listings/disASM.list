E3E6 DD 7E 04    4 422 ld      a, (ix+4)                   ; Get operand #2 string number
E3E9 4A          4 423 ld      c, d                        ; Get primary opcode value
E3EA CD 73 01    4 424 Realloc_47          call    DisWrOperand-START
E3ED             4 425 NoOp2:
