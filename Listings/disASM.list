E3A7 20 14       4 379 jr      nz, NotFound                ; No, so this is not the correct table
E3A9             4 380 ; BASIC: ... AND (p = iPrecode(n)) ?
E3A9 AF          4 381 xor     a                           ; Default precode for comparison = 0x00
E3AA DD CB 03 7E 4 382 bit     7, (ix+3)                   ; Precode (index or extended)?
E3AE 28 0A       4 383 jr      z, GotPrCode                ; No, so skip
E3B0 3E CB       4 384 ld      a, $CB                      ; Default precode for comparison = 0xCB
E3B2 DD CB 03 76 4 385 bit     6, (ix+3)                   ; Precode = 0xED?
E3B6 28 02       4 386 jr      z, GotPrCode                ; No, so skip
E3B8 3E ED       4 387 ld      a, $ED                      ; Yes, so precode for comparison = 0xED
E3BA             4 388 GotPrCode:
E3BA BB          4 389 cp      e                           ; Compare table precode with instruction
E3BB 28 09       4 390 jr      z, Found                    ; Yes, so this is the correct table
E3BD             4 391 NotFound:
E3BD 78          4 392 ld      a, b                        ; Preserve offset to primary opcode
E3BE 01 05 00    4 393 ld      bc, 5                       ; Point to next table entry
E3C1 DD 09       4 394 add     ix, bc
E3C3 47          4 395 ld      b, a                        ; Restore offset to primary opcode
E3C4 18 D5       4 396 jr      Table
E3C6             4 398 ; We now have the correct instruction table entry (pointer to by IX)
E3C6             4 399 ; BASIC: (p = iPrecode(n)) And (i And iMask(n)) = (iValue(n) And iMask(n))
E3C6             4 400 Found:
E3C6 DD 7E 02    4 401 ld      a, (ix+2)                   ; Get operation string number
E3C9 21 3E 01    4 402 Realloc_42          ld      hl, iDisOpStr-START+1       ; Store operation string number
