E3A8 AF          4 381 xor     a                           ; Default precode for comparison = 0x00
E3A9 DD CB 03 7E 4 382 bit     7, (ix+3)                   ; Precode (index or extended)?
E3AD 28 0A       4 383 jr      z, GotPrCode                ; No, so skip
E3AF 3E CB       4 384 ld      a, $CB                      ; Default precode for comparison = 0xCB
E3B1 DD CB 03 76 4 385 bit     6, (ix+3)                   ; Precode = 0xED?
E3B5 28 02       4 386 jr      z, GotPrCode                ; No, so skip
