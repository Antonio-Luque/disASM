E419 3E 0D       4 460 ld      a, CHR_ENTER
E41B CD FD 00    4 461 Realloc_52          call    StrWrChar-START
E41E 78          4 463 ld      a, b                        ; Get offset into instruction
E41F 3C          4 464 inc     a                           ; Increment to give instruction length
E420 FD E1       4 466 pop     iy                          ; Restore system variables pointer
E422 FB          4 467 ei                                  ; Enable interrupts
E423 C9          4 468 ret
E424             4 471 ; Disassembler: Get instruction opcode
E424             4 472 ;   On entry: A = Offset from start of instruction
E424             4 473 ;             IY = Start of instruction
E424             4 474 ;   On exit:  A = Opcode
E424             4 475 ;             BC DE HL IX IY I AF' BC' DE' HL' preserved
E424             4 476 DisGetOpcode:
E424 C5          4 477 push    bc                          ; Store registers
E425 FD E5       4 478 push    iy
E427 4F          4 479 ld      c, a                        ; Offset from start of instruction
E428 06 00       4 480 ld      b, 0                        ; Clear hi byte ready for addition
E42A FD 09       4 481 add     iy, bc                      ; Calculate location of opcode
E42C FD 7E 00    4 482 ld      a, (iy+0)                   ; Get opcode from memory
E42F FD E1       4 483 pop     iy                          ; Restore registers
E431 C1          4 484 pop     bc
E432 C9          4 485 ret
E433             4 487 ; Disassembler: How it works...
E433             4 488 ; Solution is to use data table to define functions for each operand (see below)
E433             4 489 ; Decoding table: where the table entry is determined by the operand string number
E433             4 490 ; String numbers 0 to 12:
E433             4 491 ;   If bracket flagged print "("
E433             4 492 ;   If immediate byte flagged print hex byte at PC+Offset+1, Offset += 1
E433             4 493 ;   If immediate word flagged print word byte at PC+Offset+1 and PC+Offset+2, Offset += 2
E433             4 494 ;   If bracket flagged print ")"
E433             4 495 ;   If substitution string specified: (non-zero value)
E433             4 496 ;     n = opcode and SubsMask
E433             4 497 ;     n = n >> x, where x is the number of right shifts of the mask til bit 0 is a 1
E433             4 498 ;     If subsLen is 2 then n = n << 1
E433             4 499 ;     c =  character at (start of Substitution String + n + 0)
E433             4 500 ;     if = "-" then print "(HL)" else print character c
E433             4 501 ;     If SubsLen = 2 then
E433             4 502 ;       print character at (start of Substitution String + n + 1)
E433             4 503 ;     Endif
E433             4 504 ;   End if

; File #5: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\Utilities.z80asm

E433             5 1 ; **********************************************************************************************************************
E433             5 2 ; **  Utility functions                                                                         by Stephen C Cousins  **
E433             5 3 ; **********************************************************************************************************************
E433             5 6 ; Utility: Find start of specified string in bit 7 delimited list
E433             5 7 ;   On entry: A = String number
E433             5 8 ;   On exit:  HL = Start of string
E433             5 9 ;             BC DE IX IY I AF' BC' DE' HL' preserved
E433             5 10 ; Find string A in bit 7 delimited string list
E433             5 11 FindStringInList:
E433 C5          5 12 push    bc
E434 21 41 03    5 14 Realloc_53          ld      hl, DisString-START         ; Start of string list
E437 47          5 15 ld      b, a                        ; Get string number
E438             5 16 NextChar:
E438 CB 7E       5 17 bit     7, (hl)                     ; End of string?
E43A 23          5 18 inc     hl                          ; Point to next character
E43B 28 FB       5 19 jr      z, NextChar                 ; No, so go get next character
E43D 10 F9       5 20 djnz    NextChar                    ; Loop back if not the right string
E43F C1          5 22 pop     bc
E440 C9          5 23 ret

; File #6: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\DisData.z80asm

E441             6 1 ; **********************************************************************************************************************
E441             6 2 ; **  Disassembler data                                                                         by Stephen C Cousins  **
E441             6 3 ; **********************************************************************************************************************
E441             6 6 ; Disassembler string table: (DisString)
E441             6 7 ; This contains many string which are not null terminated and have no length 
E441             6 8 ; value. Instead they are tightly packed with the end of each string 
E441             6 9 ; indicated by the last character having bit 7 set.
E441             6 10 DisString:
