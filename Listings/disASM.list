E2B7 3E 29       4 180 ld      a, ')'                      ; Get right bracket character
E2B9 CD FD 00    4 181 Realloc_23          call    StrWrChar-START             ; Print right bracket
E2BC             4 182 NoBracR:
E2BC             4 183 ; Process this operand as detailed in DE, substitution string?
E2BC D1          4 184 pop     de                          ; Restore details
E2BD 7B          4 186 ld      a, e                        ; Get substitution string number
E2BE B7          4 187 or      a                           ; String specified?
