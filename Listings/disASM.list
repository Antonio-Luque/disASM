E2B0 CD EC 00    4 175 Realloc_22          call    StrWrHexByte-START          ; Print lo byte of immediate value
E2B3             4 176 NoImmedia:
E2B3             4 177 ; Process this operand as detailed in DE, right bracket?
E2B3 CB 6A       4 178 bit     kDisBrack, d                ; Bracket flagged?
