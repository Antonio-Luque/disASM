E2C7 6F          4 193 ld      l, a                        ; Store updated lo byte
E2C8 30 01       4 194 jr      nc, NoOFlow                 ; Skip if no overflow
E2CA 24          4 195 inc     h                           ; Overflow so increment hi byte
