E423             4 471 ; Disassembler: Get instruction opcode
E423             4 472 ;   On entry: A = Offset from start of instruction
E423             4 473 ;             IY = Start of instruction
E423             4 474 ;   On exit:  A = Opcode
E423             4 475 ;             BC DE HL IX IY I AF' BC' DE' HL' preserved
E423             4 476 DisGetOpcode:
E423 C5          4 477 push    bc                          ; Store registers
E424 FD E5       4 478 push    iy
E426 4F          4 479 ld      c, a                        ; Offset from start of instruction
E427 06 00       4 480 ld      b, 0                        ; Clear hi byte ready for addition
E429 FD 09       4 481 add     iy, bc                      ; Calculate location of opcode
E42B FD 7E 00    4 482 ld      a, (iy+0)                   ; Get opcode from memory
E42E FD E1       4 483 pop     iy                          ; Restore registers
E430 C1          4 484 pop     bc
E431 C9          4 485 ret
E432             4 487 ; Disassembler: How it works...
E432             4 488 ; Solution is to use data table to define functions for each operand (see below)
E432             4 489 ; Decoding table: where the table entry is determined by the operand string number
E432             4 490 ; String numbers 0 to 12:
E432             4 491 ;   If bracket flagged print "("
E432             4 492 ;   If immediate byte flagged print hex byte at PC+Offset+1, Offset += 1
E432             4 493 ;   If immediate word flagged print word byte at PC+Offset+1 and PC+Offset+2, Offset += 2
E432             4 494 ;   If bracket flagged print ")"
E432             4 495 ;   If substitution string specified: (non-zero value)
E432             4 496 ;     n = opcode and SubsMask
E432             4 497 ;     n = n >> x, where x is the number of right shifts of the mask til bit 0 is a 1
E432             4 498 ;     If subsLen is 2 then n = n << 1
E432             4 499 ;     c =  character at (start of Substitution String + n + 0)
E432             4 500 ;     if = "-" then print "(HL)" else print character c
E432             4 501 ;     If SubsLen = 2 then
E432             4 502 ;       print character at (start of Substitution String + n + 1)
E432             4 503 ;     Endif
E432             4 504 ;   End if

; File #5: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\Utilities.z80asm

E432             5 1 ; **********************************************************************************************************************
E432             5 2 ; **  Utility functions                                                                         by Stephen C Cousins  **
E432             5 3 ; **********************************************************************************************************************
E432             5 6 ; Utility: Find start of specified string in bit 7 delimited list
E432             5 7 ;   On entry: A = String number
E432             5 8 ;   On exit:  HL = Start of string
E432             5 9 ;             BC DE IX IY I AF' BC' DE' HL' preserved
E432             5 10 ; Find string A in bit 7 delimited string list
E432             5 11 FindStringInList:
E432 C5          5 12 push    bc
E433 21 40 03    5 14 Realloc_53          ld      hl, DisString-START         ; Start of string list
E436 47          5 15 ld      b, a                        ; Get string number
E437             5 16 NextChar:
E437 CB 7E       5 17 bit     7, (hl)                     ; End of string?
E439 23          5 18 inc     hl                          ; Point to next character
E43A 28 FB       5 19 jr      z, NextChar                 ; No, so go get next character
E43C 10 F9       5 20 djnz    NextChar                    ; Loop back if not the right string
E43E C1          5 22 pop     bc
E43F C9          5 23 ret

; File #6: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\DisData.z80asm

E440             6 1 ; **********************************************************************************************************************
E440             6 2 ; **  Disassembler data                                                                         by Stephen C Cousins  **
E440             6 3 ; **********************************************************************************************************************
E440             6 6 ; Disassembler string table: (DisString)
E440             6 7 ; This contains many string which are not null terminated and have no length 
E440             6 8 ; value. Instead they are tightly packed with the end of each string 
E440             6 9 ; indicated by the last character having bit 7 set.
