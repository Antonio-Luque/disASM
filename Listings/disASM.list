E2C4 21 FA 06    4 191 Realloc_24          ld      hl, DisMaskTable-START      ; Point to table of mask bits
E2C7 85          4 192 add     a, l                        ; Add to start of table
E2C8 6F          4 193 ld      l, a                        ; Store updated lo byte
E2C9 30 01       4 194 jr      nc, NoOFlow                 ; Skip if no overflow
E2CB 24          4 195 inc     h                           ; Overflow so increment hi byte
E2CC             4 196 NoOFlow:
E2CC 7E          4 197 ld      a, (hl)                     ; Get bit mask
E2CD A1          4 198 and     c                           ; Mask primary opcode
