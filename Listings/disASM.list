E3E0 28 0C       4 417 jr      z, NoOp2                    ; Yes, so skip this operand
E3E2 3E 2C       4 419 ld      a, ','                      ; Get comma character
E3E4 CD FD 00    4 420 Realloc_46          call    StrWrChar-START             ; Write comma to string
E3E7 DD 7E 04    4 422 ld      a, (ix+4)                   ; Get operand #2 string number
E3EA 4A          4 423 ld      c, d                        ; Get primary opcode value
E3EB CD 74 01    4 424 Realloc_47          call    DisWrOperand-START
E3EE             4 425 NoOp2:
