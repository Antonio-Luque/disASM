E7E0             6 256 ; Operand table:
E7E0             6 257 ;   Index into table is the operand string number 1 to 13)
E7E0             6 258 ;   Contents: Substitution string number, function bits BIILMM
E7E0             6 259 ;
E7E0             6 260 ; Op  String  Offset  Bracket  Immediate  Substitue     subsLen  subsMask  ->  BIILMM
E7E0             6 261 ;  1  =""     +0      No       No   (00)  No                n/a  n/a           000000
E7E0             6 262 ;  2  ="n"    +1      No       Byte (10)  No                n/a  n/a           010000
E7E0             6 263 ;  3  ="(n)"  +1      Yes      Byte (10)  No                n/a  n/a           110000
E7E0             6 264 ;  4  ="nn"   +2      No       Word (11)  No                n/a  n/a           011000
E7E0             6 265 ;  5  ="(nn)" +2      Yes      Word (11)  No                n/a  n/a           111000
E7E0             6 266 ;  6  ="r"    +0      No       No   (00)  "BCDEHL-A"          1  0x38 (11)     000011
E7E0             6 267 ;  7  ="r2"   +0      No       No   (00)  "BCDEHL-A"          1  0x07 (00)     000000
E7E0             6 268 ;  8  ="dd"   +0      No       No   (00)  "BCDEHLSP"          2  0x30 (10)     000110
E7E0             6 269 ;  9  ="qq"   +0      No       No   (00)  "BCDEHLAF"          2  0x30 (10)     000110
E7E0             6 270 ; 10  ="c"    +0      No       No   (00)  "NZZ NCC "          2  0x18 (01)     000101
E7E0             6 271 ; 11  ="cc"   +0      No       No   (00)  "NZZ NCC POPEP M "  2  0x38 (11)     000111
E7E0             6 272 ; 12  ="t"    +0      No       No   (00)  "0008162432404856"  2  0x38 (11)     000111
E7E0             6 273 ; 13  ="b"    +0      No       No   (00)  "01234567"          1  0x38 (11)     000011
E7E0             6 274 ; Each table entry is coded with the string number plus a byte containing BIILMM bits
E7E0             6 275 ; Length bit is hi for strings with two character substitutions
E7E0             6 276 DisOperandTable:
E7E0 00 00       6 277 DEFB    $00, $00                    ; 0b000000 ;Operand  1 = ""
E7E2 00 10       6 278 DEFB    $00, $10                    ; 0b010000 ;Operand  2 = "n"
E7E4 00 30       6 279 DEFB    $00, $30                    ; 0b110000 ;Operand  3 = "(n)"
E7E6 00 18       6 280 DEFB    $00, $18                    ; 0b011000 ;Operand  4 = "nn"
E7E8 00 38       6 281 DEFB    $00, $38                    ; 0b111000 ;Operand  5 = "(nn)"
E7EA 0E 03       6 282 DEFB    $0E, $03                    ; 0b000011 ;Operand  6 = "r"
E7EC 0E 00       6 283 DEFB    $0E, $00                    ; 0b000000 ;Operand  7 = "r2"
E7EE 0F 06       6 284 DEFB    $0F, $06                    ; 0b000110 ;Operand  8 = "dd"
E7F0 10 06       6 285 DEFB    $10, $06                    ; 0b000110 ;Operand  9 = "qq"
E7F2 11 05       6 286 DEFB    $11, $05                    ; 0b000101 ;Operand 10 = "c"
E7F4 12 07       6 287 DEFB    $12, $07                    ; 0b000111 ;Operand 11 = "cc"
E7F6 13 07       6 288 DEFB    $13, $07                    ; 0b000111 ;Operand 12 = "t"
E7F8 14 03       6 289 DEFB    $14, $03                    ; 0b000011 ;Operand 13 = "b"
E7FA             6 292 ; Mask table
E7FA             6 293 ; These are the masks used to separate token values such as register "BCDEHL-A"
E7FA             6 294 ; The index into the table is coded in the two mask bits from the above table.
