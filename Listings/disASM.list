E46B             4 486 ; Disassembler: How it works...
E46B             4 487 ; Solution is to use data table to define functions for each operand (see below)
E46B             4 488 ; Decoding table: where the table entry is determined by the operand string number
E46B             4 489 ; String numbers 0 to 12:
E46B             4 490 ;   If bracket flagged print "("
E46B             4 491 ;   If immediate byte flagged print hex byte at PC+Offset+1, Offset += 1
E46B             4 492 ;   If immediate word flagged print word byte at PC+Offset+1 and PC+Offset+2, Offset += 2
E46B             4 493 ;   If bracket flagged print ")"
E46B             4 494 ;   If substitution string specified: (non-zero value)
E46B             4 495 ;     n = opcode and SubsMask
E46B             4 496 ;     n = n >> x, where x is the number of right shifts of the mask til bit 0 is a 1
E46B             4 497 ;     If subsLen is 2 then n = n << 1
E46B             4 498 ;     c =  character at (start of Substitution String + n + 0)
E46B             4 499 ;     if = "-" then print "(HL)" else print character c
E46B             4 500 ;     If SubsLen = 2 then
E46B             4 501 ;       print character at (start of Substitution String + n + 1)
E46B             4 502 ;     Endif
E46B             4 503 ;   End if

; File #5: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\Utilities.z80asm

E46B             5 1 ; **********************************************************************************************************************
E46B             5 2 ; **  Utility functions                                                                         by Stephen C Cousins  **
E46B             5 3 ; **********************************************************************************************************************
E46B             5 6 ; Utility: Find start of specified string in bit 7 delimited list
E46B             5 7 ;   On entry: A = String number
E46B             5 8 ;   On exit:  HL = Start of string
E46B             5 9 ;             BC DE IX IY I AF' BC' DE' HL' preserved
E46B             5 10 ; Find string A in bit 7 delimited string list
E46B             5 11 FindStringInList:
E46B C5          5 12 push    bc
E46C 21 78 03    5 14 Realloc_55          ld      hl, DisString-START-1       ; Start of string list
E46F 47          5 15 ld      b, a                        ; Get string number
E470             5 16 NextChar:
E470 23          5 17 inc     hl                          ; Point to next character
E471 CB 7E       5 18 bit     7, (hl)                     ; Start of new string?
E473 28 FB       5 19 jr      z, NextChar                 ; No, so go get next character
E475 10 F9       5 20 djnz    NextChar                    ; Loop back if not the right string
E477 C1          5 22 pop     bc
E478 C9          5 23 ret

