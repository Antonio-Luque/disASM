E3CD CD 10 01    4 404 Realloc_43          call    DisWrString-START           ; Write operation string
E3D0 3E 20       4 406 ld      a, ' '                      ; Write space
E3D2 CD FD 00    4 407 Realloc_44          call    StrWrChar-START
