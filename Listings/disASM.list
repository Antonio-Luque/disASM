E818             6 344 ; Operand table:
E818             6 345 ;   Index into table is the operand string number 1 to 13)
E818             6 346 ;   Contents: Substitution string number, function bits BIILMM
E818             6 347 ;
E818             6 348 ; Op  String  Offset  Bracket  Immediate  Substitue     subsLen  subsMask  ->  BIILMM
E818             6 349 ;  1  =""     +0      No       No   (00)  No                n/a  n/a           000000
E818             6 350 ;  2  ="n"    +1      No       Byte (10)  No                n/a  n/a           010000
E818             6 351 ;  3  ="(n)"  +1      Yes      Byte (10)  No                n/a  n/a           110000
E818             6 352 ;  4  ="nn"   +2      No       Word (11)  No                n/a  n/a           011000
E818             6 353 ;  5  ="(nn)" +2      Yes      Word (11)  No                n/a  n/a           111000
E818             6 354 ;  6  ="r"    +0      No       No   (00)  "BCDEHL-A"          1  0x38 (11)     000011
E818             6 355 ;  7  ="r2"   +0      No       No   (00)  "BCDEHL-A"          1  0x07 (00)     000000
E818             6 356 ;  8  ="dd"   +0      No       No   (00)  "BCDEHLSP"          2  0x30 (10)     000110
E818             6 357 ;  9  ="qq"   +0      No       No   (00)  "BCDEHLAF"          2  0x30 (10)     000110
E818             6 358 ; 10  ="c"    +0      No       No   (00)  "NZZ NCC "          2  0x18 (01)     000101
E818             6 359 ; 11  ="cc"   +0      No       No   (00)  "NZZ NCC POPEP M "  2  0x38 (11)     000111
E818             6 360 ; 12  ="t"    +0      No       No   (00)  "0008101820283038"  2  0x38 (11)     000111
E818             6 361 ; 13  ="b"    +0      No       No   (00)  "01234567"          1  0x38 (11)     000011
E818             6 362 ; Each table entry is coded with the string number plus a byte containing BIILMM bits
E818             6 363 ; Length bit is hi for strings with two character substitutions
E818             6 364 DisOperandTable:
E818 00 00       6 365 DEFB    $00, $00                    ; 0b000000 ;Operand  1 = ""
E81A 00 10       6 366 DEFB    $00, $10                    ; 0b010000 ;Operand  2 = "n"
E81C 00 30       6 367 DEFB    $00, $30                    ; 0b110000 ;Operand  3 = "(n)"
E81E 00 18       6 368 DEFB    $00, $18                    ; 0b011000 ;Operand  4 = "nn"
E820 00 38       6 369 DEFB    $00, $38                    ; 0b111000 ;Operand  5 = "(nn)"
E822 0E 03       6 370 DEFB    $0E, $03                    ; 0b000011 ;Operand  6 = "r"
E824 0E 00       6 371 DEFB    $0E, $00                    ; 0b000000 ;Operand  7 = "r2"
E826 0F 06       6 372 DEFB    $0F, $06                    ; 0b000110 ;Operand  8 = "dd"
E828 10 06       6 373 DEFB    $10, $06                    ; 0b000110 ;Operand  9 = "qq"
E82A 11 05       6 374 DEFB    $11, $05                    ; 0b000101 ;Operand 10 = "c"
E82C 12 07       6 375 DEFB    $12, $07                    ; 0b000111 ;Operand 11 = "cc"
E82E 13 07       6 376 DEFB    $13, $07                    ; 0b000111 ;Operand 12 = "t"
E830 14 03       6 377 DEFB    $14, $03                    ; 0b000011 ;Operand 13 = "b"
E832             6 380 ; Mask table
E832             6 381 ; These are the masks used to separate token values such as register "BCDEHL-A"
E832             6 382 ; The index into the table is coded in the two mask bits from the above table.
E832             6 383 DisMaskTable:
E832 07          6 384 DEFB    $07                         ; Mask type 0
E833 18          6 385 DEFB    $18                         ; Mask type 1
E834 30          6 386 DEFB    $30                         ; Mask type 2
E835 38          6 387 DEFB    $38                         ; Mask type 3
