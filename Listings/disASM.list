E7DF             6 256 ; Operand table:
E7DF             6 257 ;   Index into table is the operand string number 1 to 13)
E7DF             6 258 ;   Contents: Substitution string number, function bits BIILMM
E7DF             6 259 ;
E7DF             6 260 ; Op  String  Offset  Bracket  Immediate  Substitue     subsLen  subsMask  ->  BIILMM
E7DF             6 261 ;  1  =""     +0      No       No   (00)  No                n/a  n/a           000000
E7DF             6 262 ;  2  ="n"    +1      No       Byte (10)  No                n/a  n/a           010000
E7DF             6 263 ;  3  ="(n)"  +1      Yes      Byte (10)  No                n/a  n/a           110000
E7DF             6 264 ;  4  ="nn"   +2      No       Word (11)  No                n/a  n/a           011000
E7DF             6 265 ;  5  ="(nn)" +2      Yes      Word (11)  No                n/a  n/a           111000
E7DF             6 266 ;  6  ="r"    +0      No       No   (00)  "BCDEHL-A"          1  0x38 (11)     000011
E7DF             6 267 ;  7  ="r2"   +0      No       No   (00)  "BCDEHL-A"          1  0x07 (00)     000000
E7DF             6 268 ;  8  ="dd"   +0      No       No   (00)  "BCDEHLSP"          2  0x30 (10)     000110
E7DF             6 269 ;  9  ="qq"   +0      No       No   (00)  "BCDEHLAF"          2  0x30 (10)     000110
E7DF             6 270 ; 10  ="c"    +0      No       No   (00)  "NZZ NCC "          2  0x18 (01)     000101
E7DF             6 271 ; 11  ="cc"   +0      No       No   (00)  "NZZ NCC POPEP M "  2  0x38 (11)     000111
E7DF             6 272 ; 12  ="t"    +0      No       No   (00)  "0008101820283038"  2  0x38 (11)     000111
E7DF             6 273 ; 13  ="b"    +0      No       No   (00)  "01234567"          1  0x38 (11)     000011
E7DF             6 274 ; Each table entry is coded with the string number plus a byte containing BIILMM bits
E7DF             6 275 ; Length bit is hi for strings with two character substitutions
E7DF             6 276 DisOperandTable:
E7DF 00 00       6 277 DEFB    $00, $00                    ; 0b000000 ;Operand  1 = ""
E7E1 00 10       6 278 DEFB    $00, $10                    ; 0b010000 ;Operand  2 = "n"
E7E3 00 30       6 279 DEFB    $00, $30                    ; 0b110000 ;Operand  3 = "(n)"
E7E5 00 18       6 280 DEFB    $00, $18                    ; 0b011000 ;Operand  4 = "nn"
E7E7 00 38       6 281 DEFB    $00, $38                    ; 0b111000 ;Operand  5 = "(nn)"
E7E9 0E 03       6 282 DEFB    $0E, $03                    ; 0b000011 ;Operand  6 = "r"
E7EB 0E 00       6 283 DEFB    $0E, $00                    ; 0b000000 ;Operand  7 = "r2"
E7ED 0F 06       6 284 DEFB    $0F, $06                    ; 0b000110 ;Operand  8 = "dd"
E7EF 10 06       6 285 DEFB    $10, $06                    ; 0b000110 ;Operand  9 = "qq"
E7F1 11 05       6 286 DEFB    $11, $05                    ; 0b000101 ;Operand 10 = "c"
E7F3 12 07       6 287 DEFB    $12, $07                    ; 0b000111 ;Operand 11 = "cc"
E7F5 13 07       6 288 DEFB    $13, $07                    ; 0b000111 ;Operand 12 = "t"
E7F7 14 03       6 289 DEFB    $14, $03                    ; 0b000011 ;Operand 13 = "b"
E7F9             6 292 ; Mask table
E7F9             6 293 ; These are the masks used to separate token values such as register "BCDEHL-A"
E7F9             6 294 ; The index into the table is coded in the two mask bits from the above table.
E7F9             6 295 DisMaskTable:
E7F9 07          6 296 DEFB    $07                         ; Mask type 0
E7FA 18          6 297 DEFB    $18                         ; Mask type 1
E7FB 30          6 298 DEFB    $30                         ; Mask type 2
E7FC 38          6 299 DEFB    $38                         ; Mask type 3
