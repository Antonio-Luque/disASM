
; File #0: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\disASM.z80asm

8000             0 1 ; **********************************************************************************************************************
8000             0 2 ; **  disASM                                                                                                          **
8000             0 3 ; **                                                                                                                  **
8000             0 4 ; **  Based on Disassembler support from Small Computer Monitor (SCM)                           by Stephen C Cousins  **
8000             0 5 ; **  https://smallcomputercentral.com/small-computer-monitor/small-computer-monitor-v1-0/                            **
8000             0 6 ; **                                                                                                                  **
8000             0 7 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
8000             0 8 ; **********************************************************************************************************************
8000             0 11 START               ORG     $E100                       ; Default address, can be reallocated below the System Variables
E100             0 12 PR_STRING           EQU     $203C                       ; Print string ROM routine
E100             0 14 Main:
E100 21 0C 07    0 15 ld      hl, Realloc_Addrs-START     ; HL points to relative address of Realloc_Addrs
E103 09          0 16 add     hl, bc                      ; Move HL to absolute address of reallocation addresses
E104             0 17 ; Avoid 'call Reallocation'

; File #1: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\Reallocation.z80asm

E104             1 1 ; **********************************************************************************************************************
E104             1 2 ; **  Reallocation                                                                        by HiSoft Devpac, (C) 1983  **
E104             1 3 ; **                                                                                                                  **
E104             1 4 ; **  This piece of code has been disassembled from MONS v4.1 and adapted for disASM by Antonio Luque                 **
E104             1 5 ; **********************************************************************************************************************
E104             1 8 ; Reallocate pointers and calls pointed to by the 'Realloc_X' tags
E104             1 9 ;   On entry: HL = address of reallocation addresses (Realloc_Addrs)
E104             1 10 ;             BC = address of program start
E104             1 11 ;   On exit:  BC IX IY I AF' BC' DE' HL' preserved
E104             1 12 Reallocation:
E104 5E          1 13 ld      e, (hl)                     ; DE = relative reallocation address
E105 23          1 14 inc     hl
E106 56          1 15 ld      d, (hl)
E107 23          1 16 inc     hl                          ; Move HL to next relative reallocation address
E108 7A          1 17 ld      a, d                        ; last address?
E109 B3          1 18 or      e
E10A 28 11       1 19 jr      z, Re_Entry                 ; yes, reallocation finished
E10C EB          1 21 ex      de, hl                      ; HL = relative reallocation address
E10D 09          1 22 add     hl, bc                      ; HL points to address parameter of the instr. at 'Realloc_X'
E10E D5          1 23 push    de                          ; Store next relative reallocation address
E10F E5          1 24 push    hl                          ; Store pointer to address parameter of the instruction
E110 5E          1 25 ld      e, (hl)                     ; Save the content of the address parameter in DE
E111 23          1 26 inc     hl
E112 56          1 27 ld      d, (hl)
E113 EB          1 28 ex      de, hl                      ; Calculate absolute address in HL
E114 09          1 29 add     hl, bc
E115 EB          1 30 ex      de, hl                      ; DE = absolute address parameter of the instruction
E116 E1          1 31 pop     hl                          ; Restore pointer to address parameter of the instruction
E117 73          1 32 ld      (hl), e                     ; Update address parameter of the instruction with calculated
E118 23          1 33 inc     hl                          ;   absolute address
E119 72          1 34 ld      (hl), d
E11A E1          1 35 pop     hl                          ; Restore next relative reallocation address
E11B 18 E7       1 36 jr      Reallocation                ; Repeat again
E11D             1 38 ; From this point on, all address parameters of the instructions pointed to by the 'Realloc_X' tags
E11D             1 39 ;  have been updated with the corresponding absolute address.
E11D             1 41 Re_Entry:
E11D             1 42 ; Put 'JP Init' at the start of program for the re-entry
E11D 3E C3       1 43 ld      a, $C3                      ; 'JP' opcode
E11F 32 00 00    1 44 Realloc_A           ld      ($0000), a                  ; Put it at program start
E122 21 28 00    1 45 Realloc_B           ld      hl, Init-START              ; HL points to Init
E125 22 01 00    1 46 Realloc_C           ld      ($0001), hl                 ; Put Init address as parameter of JP instruction

; File #0: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\disASM.z80asm

E128             0 20 ; Re-entry of program after first execution
E128             0 21 Init:
E128 21 7E 07    0 22 ld      hl, END-START               ; HL points to relative address of stack address
E12B 09          0 23 add     hl, bc                      ; Move HL to absolute address of stack addresses
E12C F9          0 24 ld      sp, hl                      ; Move stack at bottom of Realloc_Addrs
E12D CD 4A 00    0 26 Realloc_1           call    InputAddresses-START        ; Input "from" and "to" addresses from keyboard
E130             0 28 ; Disassembly loop
E130             0 29 DisInstruction:
E130 C5          0 30 push    bc                          ; Store "to"+1 address
E131 D5          0 31 push    de                          ; Store string buffer address
E132 CD 29 02    0 33 Realloc_2           call    DisWrInstruction-START      ; Write fully disassembly instruction in buffer
E135 11 0C 07    0 34 Realloc_3           ld      de, kStrBuffer-START        ; DE points to string buffer
E138 1A          0 35 ld      a, (de)                     ; Get string length
E139 4F          0 36 ld      c, a                        ; BC = length of the string
E13A 06 00       0 37 ld      b, 0
E13C 13          0 38 inc     de                          ; Move DE to the start of the string
E13D CD 3C 20    0 39 call    PR_STRING                   ; Print string
E140 D1          0 41 pop     de                          ; Restore string buffer address
E141 C1          0 42 pop     bc                          ; Restore "to"+1 address
E142 A7          0 44 and     a                           ; reset carry flag
E143 ED 42       0 45 sbc     hl, bc                      ; check if reach "to"+1 address
E145 09          0 46 add     hl, bc
E146 38 E8       0 47 jr      c, DisInstruction           ; loop until reach "to"+1 address
E148             0 49 ; Return to BASIC: "0 OK, "
E148 CF          0 50 rst     $08
E149 FF          0 51 DEFB    $FF
E14A             0 54 ; Support routines and data

; File #2: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\IOSupport.z80asm

E14A             2 1 ; **********************************************************************************************************************
E14A             2 2 ; **  Input/Output support                                                                          by Antonio Luque  **
E14A             2 3 ; **********************************************************************************************************************
E14A             2 6 ; ROM routines and system variables
E14A             2 7 CLS_LOWER           EQU     $0D6E                       ; Clear the lower part of the display
E14A             2 8 CL_ALL              EQU     $0DAF                       ; Clear the whole display area
E14A             2 9 LAST_K              EQU     $5C08                       ; Last key pressed
E14A             2 11 ; Control characters
E14A             2 12 CHR_LEFT            EQU     $08                         ; Move cursor backwards
E14A             2 13 CHR_DELETE          EQU     $0C                         ; Delete
E14A             2 14 CHR_FLASH           EQU     $12                         ; Flash attribute
E14A             2 17 ; IOSupport: Input "from" and "to" addresses from keyboard
E14A             2 18 ;  On entry: -
E14A             2 19 ;  On exit:  HL = Start of instruction to be disassembled ("from")
E14A             2 20 ;            BC = End of instrucction to be disassembled ("to"+1)
E14A             2 21 ;            DE = Start of string buffer
E14A             2 22 ;            IX IY I AF' preserved
E14A             2 23 ; Adapted from MONS v4.1 by HiSoft Devpac, (C) 1983
E14A             2 24 InputAddresses:
E14A CD 6E 0D    2 25 call    CLS_LOWER                   ; Clear the lower part of the display
E14D FD CB 30 5E 2 27 bit     3, (iy+48)                  ; Query CAPS LOCK flag (FLAGS2 system variable)
E151 F5          2 28 push    af                          ; Store flags to maintain status
E152 FD CB 30 DE 2 29 set     3, (iy+48)                  ; Set CAPS LOCK (FLAGS2 system variable)
E156 11 FE 06    2 31 Realloc_4           ld      de, StrLabels-START         ; DE points to "from" string
E159 06 02       2 32 ld      b, 2                        ; Number of inputs: "from" and "to" (loop counter)
E15B             2 33 Print_Label:
E15B C5          2 34 push    bc                          ; Store current number of inputs
E15C 01 07 00    2 35 ld      bc, 7                       ; Length of string
E15F CD 3C 20    2 36 call    PR_STRING                   ; Print string
E162 D5          2 37 push    de                          ; Store next string pointer
E163 0C          2 38 inc     c                           ; Set C = 0 (current number of nibbles)
E164             2 39 Get_Address:
E164 3E 12       2 40 ld      a, CHR_FLASH                ; Activate flash attribute
E166 D7          2 41 rst     $10
E167 3E 01       2 42 ld      a, 1
E169 D7          2 43 rst     $10
E16A 3E 43       2 44 ld      a, 'C'                      ; Print 'C' cursor
E16C D7          2 45 rst     $10
E16D 3E 12       2 46 ld      a, CHR_FLASH                ; Deactivate flash attribute
E16F D7          2 47 rst     $10
E170 AF          2 48 xor     a
E171 D7          2 49 rst     $10
E172 FD CB 01 AE 2 50 res     5, (iy+1)                   ; Set key pressed flag = off
E176             2 51 Wait_Key:
E176 FD CB 01 6E 2 52 bit     5, (iy+1)                   ; Key pressed?
E17A 28 FA       2 53 jr      z, Wait_Key                 ; No, repeat until key pressed
E17C 3E 08       2 54 ld      a, CHR_LEFT                 ; Move cursor left
E17E D7          2 55 rst     $10
E17F 3A 08 5C    2 56 ld      a, (LAST_K)                 ; Get ASCII code of key pressed
E182 FE 0C       2 57 cp      CHR_DELETE                  ; Is it Delete?
E184 28 35       2 58 jr      z, Delete                   ; Yes, perform deleting of previous character
E186 FE 30       2 59 cp      '0'                         ; Is it < '0' ?
E188 38 DA       2 60 jr      c, Get_Address              ; Yes, repeat key input
E18A FE 47       2 61 cp      'G'                         ; Is it >= 'G' ?
E18C 30 D6       2 62 jr      nc, Get_Address             ; Yes, repeat key input
E18E FE 3A       2 63 cp      ':'                         ; Is it < ':' ?
E190 38 04       2 64 jr      c, Input_OK                 ; Yes, perform key input
E192 FE 41       2 65 cp      'A'                         ; Is it < 'A' ?
E194 38 CE       2 66 jr      c, Get_Address              ; Yes, repeat key input
E196             2 68 ; ASCII code is between '0' and '9' or between 'A' and 'F'
E196             2 69 Input_OK:
E196 D7          2 70 rst     $10                         ; Print ASCII code
E197 3A 08 5C    2 71 ld      a, (LAST_K)                 ; Get ASCII code of key pressed in A
E19A D6 30       2 72 sub     '0'                         ; Convert ASCII to decimal number range
E19C FE 0A       2 73 cp      10                          ; Is it in range 0..9 ?
E19E 38 02       2 74 jr      c, High_Nibble              ; Yes, perform high nibble
E1A0 D6 07       2 75 sub     'A'-'0'-10                  ; No, convert to range A..F
E1A2             2 76 High_Nibble:
E1A2 0C          2 77 inc     c                           ; Increment current number of nibbles
E1A3 CB 41       2 78 bit     0, c                        ; Check if number of nibbles is odd or even 
E1A5 28 05       2 79 jr      z, Low_Nibble               ; If odd, perform low nibble
E1A7 87          2 80 add     a, a                        ; Multiply number by 16
E1A8 87          2 81 add     a, a
E1A9 87          2 82 add     a, a
E1AA 87          2 83 add     a, a
E1AB 47          2 84 ld      b, a                        ; Save high nibble in B
E1AC             2 85 Low_Nibble:
E1AC B0          2 86 or      b                           ; Bitwise OR with high nibble (get byte)
E1AD 47          2 87 ld      b, a                        ; Save byte in B
E1AE 79          2 88 ld      a, c                        ; Get current number of nibbles
E1AF FE 04       2 89 cp      4                           ; Is it 4 ?
E1B1 28 1F       2 90 jr      z, Next_Address             ; Yes, prepare for next address
E1B3 1F          2 91 rra                                 ; Is it odd ?
E1B4 38 AE       2 92 jr      c, Get_Address              ; Yes, continue with next nibble
E1B6 60          2 93 ld      h, b                        ; Store high byte of address in H
E1B7 06 00       2 94 ld      b, 0                        ; Reset high nibble
E1B9 18 A9       2 95 jr      Get_Address                 ; Continue with next nibble
E1BB             2 96 ; Delete key pressed
E1BB             2 97 Delete:
E1BB 79          2 98 ld      a, c                        ; Get current number of nibbles
E1BC B7          2 99 or      a                           ; Is it = 0 ?
E1BD 28 A5       2 100 jr      z, Get_Address              ; Yes, nothing to delete
E1BF 1F          2 101 rra                                 ; Is it odd ?
E1C0 38 04       2 102 jr      c, Cursor_Left              ; Yes, move cursor left
E1C2 7C          2 103 ld      a, h                        ; If even, recover previous byte from H
E1C3 E6 F0       2 104 and     %11110000                   ;  and store high nibble in B
E1C5 47          2 105 ld      b, a
E1C6             2 106 Cursor_Left:
E1C6 0D          2 107 dec     c                           ; Decrement number of nibbles
E1C7 3E 20       2 108 ld      a, ' '                      ; Print space (delete character)
E1C9 D7          2 109 rst     $10
E1CA 3E 08       2 110 ld      a, CHR_LEFT                 ; Move cursor left two times
E1CC D7          2 111 rst     $10
E1CD 3E 08       2 112 ld      a, CHR_LEFT
E1CF D7          2 113 rst     $10
E1D0 18 92       2 114 jr      Get_Address                 ; Continue with next nibble
E1D2             2 115 ; Store "from" address and prepare input of "to" address
E1D2             2 116 Next_Address:
E1D2 68          2 117 ld      l, b                        ; Store low byte of address in L
E1D3 D9          2 118 exx                                 ; Store address in HL'
E1D4 D1          2 119 pop     de                          ; Restore next string pointer
E1D5 C1          2 120 pop     bc                          ; Restore current number of inputs
E1D6 10 83       2 121 djnz    Print_Label                 ; Repeat for each address
E1D8             2 123 ; The "from" and "to" addresses are in HL and HL' respectively
E1D8 D9          2 124 exx                                 ; HL = "to" address, HL' = "from" address
E1D9 E5          2 125 push    hl                          ; Store "to" address
E1DA CD AF 0D    2 126 call    CL_ALL                      ; Clear display area
E1DD D9          2 127 exx                                 ; HL = "from" address
E1DE C1          2 128 pop     bc                          ; Restore "to" address in BC
E1DF 03          2 129 inc     bc                          ; Increment "to" address
E1E0             2 131 ; Maintain CAPS LOCK status
E1E0 F1          2 132 pop     af                          ; Restore flags
E1E1 C0          2 133 ret     nz                          ; If CAPS LOCK is set, return 
E1E2 FD CB 30 9E 2 134 res     3, (iy+48)                  ; Reset CAPS LOCK (FLAGS2 system variable)
E1E6 C9          2 135 ret

; File #3: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\Strings.z80asm

E1E7             3 1 ; **********************************************************************************************************************
E1E7             3 2 ; **  String support                                                                            by Stephen C Cousins  **
E1E7             3 3 ; **                                                                                                                  **
E1E7             3 4 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
E1E7             3 5 ; **********************************************************************************************************************
E1E7             3 8 ; String: Write hex word to string buffer
E1E7             3 9 ;   On entry: DE = Hex word
E1E7             3 10 ;   On exit:  B DE HL IX IY I AF' BC' DE' HL' preserved
E1E7             3 11 StrWrHexWord:
E1E7 7A          3 12 ld      a, d                        ; Get hi byte
E1E8 CD EC 00    3 13 Realloc_5           call    StrWrHexByte-START          ; Write as two hex digits
E1EB 7B          3 14 ld      a, e                        ; Get lo byte
E1EC             3 15 ; String: Write hex byte to string buffer
E1EC             3 16 ;   On entry: A = Hex byte
E1EC             3 17 ;   On exit:  B DE HL IX IY I AF' BC' DE' HL' preserved
E1EC             3 18 StrWrHexByte:
E1EC 4F          3 19 ld      c, a                        ; Save byte to convert
E1ED 1F          3 20 rra                                 ; Shift top nibble to
E1EE 1F          3 21 rra                                 ;  botom four bits..
E1EF 1F          3 22 rra
E1F0 1F          3 23 rra
E1F1 CD F5 00    3 24 Realloc_6           call    StrWrHexNibble-START        ; Write top nibble
E1F4 79          3 25 ld      a, c                        ; Restore byte to convert
E1F5             3 26 ; String: Write hex nibble to string buffer
E1F5             3 27 ;   On entry: A = Hex nibble
E1F5             3 28 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E1F5             3 29 ; https://wikiti.brandonw.net/index.php?title=Z80_Optimization#DAA_trick
E1F5             3 30 StrWrHexNibble:
E1F5 E6 0F       3 31 and     %00001111                   ; Mask off unwanted bits
E1F7 FE 0A       3 32 cp      10                          ; if (nibble < 10) then (carry = on)
E1F9 3F          3 33 ccf                                 ; invert carry
E1FA CE 30       3 34 adc     a, '0'                      ; A = nibble + ('0' or '1')
E1FC 27          3 35 daa                                 ; convert nibble to ASCII
E1FD             3 36 ; String: Write character
E1FD             3 37 ;   On entry: A = Character to write to string buffer
E1FD             3 38 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E1FD             3 39 ; The specified character is writted to the string buffer and a null
E1FD             3 40 ; terminator added.
E1FD             3 41 StrWrChar:
E1FD E5          3 42 push    hl                          ; Store HL register
E1FE             3 43 iStrStart:
E1FE 21 00 00    3 44 ld      hl, $0000                   ; HL points to current empty position of the string
E201 77          3 45 ld      (hl), a                     ; Store character at string position
E202 23          3 46 inc     hl                          ; Move HL to next empty position
E203 22 FF 00    3 47 Realloc_7           ld      (iStrStart-START+1), hl     ; Update pointer to current empty position
E206 E1          3 48 pop     hl                          ; Restore HL register
E207 C9          3 49 ret

; File #4: C:\Users\Antonio\Source\Repos\disASM\Z80CodeFiles\DisSupport.z80asm

E208             4 1 ; **********************************************************************************************************************
E208             4 2 ; **  Disassembler support                                                                      by Stephen C Cousins  **
E208             4 3 ; **                                                                                                                  **
E208             4 4 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
E208             4 5 ; **********************************************************************************************************************
E208             4 8 kDisBrack:          EQU     5                           ; Bracket flag
E208             4 9 kDisImmed:          EQU     4                           ; Immediate value flag
E208             4 10 kDisWord:           EQU     3                           ; Immediate value is word (not byte) flag
E208             4 11 kDisLength:         EQU     2                           ; Substite two characters (not one) flag
E208             4 12 kDisMask:           EQU     3                           ; Mask type 0=0x07,1=0x18,2=0x30,3=0x38
E208             4 13 kDisSubsL:          EQU     $0D                         ; Last operand substitution string
E208             4 14 kDisBracHL:         EQU     $15                         ; Bracketed HL
E208             4 15 kDisHL:             EQU     $18                         ; Operation string 'HL'
E208             4 16 kDisJR:             EQU     $1B                         ; Operation string 'JR'
E208             4 17 kDisDJNZ:           EQU     $1C                         ; Operation string 'DJNZ'
E208             4 18 kDisJP:             EQU     $1E                         ; Operation string 'JP'
E208             4 19 kDisH               EQU     $6E                         ; Operation string 'H'
E208             4 20 kDisL               EQU     $71                         ; Operation string 'L'
E208             4 21 kDisOpMask:         EQU     $3F                         ; Operand 1 mask to exclude pre-code bits
E208             4 23 ; Control characters
E208             4 24 CHR_ENTER           EQU     $0D
E208             4 26 ; Disassembler: Write character to string buffer
E208             4 27 ;   On entry: A = Character to write
E208             4 28 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E208             4 29 ; This version of write character removes bit 7 (the end string flag)
E208             4 30 ; and replaces "-" with "(HL)"
E208             4 31 DisWrChar:
E208 E6 7F       4 32 and     %01111111                   ; Mask off bit 7 (string end bit)
E20A FE 2D       4 33 cp      '-'                         ; Code for "(HL)" ?
E20C 20 EF       4 34 jr      nz, StrWrChar               ; No, print character and return
E20E 3E 15       4 36 ld      a, kDisBracHL               ; String number for "(HL)"
E210             4 37 ; Write disassembler string
E210             4 38 ;   On entry: A = Disassembler data string number
E210             4 39 ;             B = Offset to current opcode from start of instruction
E210             4 40 ;             IY = Start address for current instruction
E210             4 41 ;   On exit:  C DE HL IX IY I AF' BC' DE' HL' preserved
E210             4 42 ;             B is incremented if (IX/IY+d) is substituted
E210             4 43 ; This version of write string removes bit 7 (the new string flag)
E210             4 44 ; If iDisTmp1 (the current index instruction opcode) is 0xDD or 0xFD, 
E210             4 45 ; is not zero then strings are replaced: 
E210             4 46 ;   HL is replaced with IX or IY
E210             4 47 ;   (HL) is replaced with (IX + d) or (IY + d) except for JP instruction
E210             4 48 ;   where is is just replaced by (IX) or (IY)
E210             4 49 DisWrString:
E210 E5          4 50 push    hl                          ; Store HL register
E211 6F          4 52 ld      l, a                        ; Store string number
E212 FE 6E       4 53 cp      kDisH                       ; String = H ?
E214 28 0C       4 54 jr      z, Subs                     ; Yes, so go do substitution
E216 FE 71       4 55 cp      kDisL                       ; String = L ?
E218 28 08       4 56 jr      z, Subs                     ; Yes, so go do substitution
E21A FE 15       4 57 cp      kDisBracHL                  ; String = (HL) ?
E21C 28 04       4 58 jr      z, Subs                     ; Yes, so go do substitution
E21E FE 18       4 59 cp      kDisHL                      ; String = HL ?
E220 20 0B       4 60 jr      nz, GotString               ; No, so just write the string
E222             4 61 ; Substitute IX/IY in HL string or (IX/IY+d) in (HL) string
E222             4 62 Subs:
E222             4 63 iDisIndex:
E222 3E 00       4 64 ld      a, $00                      ; Get index instruction opcode
E224 B7          4 65 or      a                           ; Index instruction?
E225 28 06       4 66 jr      z, GotString                ; No, so skip substitutions
E227 2C          4 67 inc     l                           ; Increment to IX string number
E228 FE DD       4 68 cp      $DD                         ; IX instruction?
E22A 28 01       4 69 jr      z, GotString                ; Yes, so go write it
E22C 2C          4 70 inc     l                           ; Increment to IY string
E22D             4 71 GotString:
E22D 7D          4 72 ld      a, l                        ; Get string number
E22E CD 33 03    4 73 Realloc_8           call    FindStringInList-START      ; Find start of string A
E231             4 75 ; HL now points to disassembler string
E231             4 76 Char:
E231 7E          4 77 ld      a, (hl)                     ; Get character from string
E232 E6 7F       4 78 and     %01111111                   ; Mask off string end bit
E234 FE 2B       4 79 cp      '+'                         ; Is it a '+' sign (displacement) ?
E236 28 05       4 80 jr      z, Plus                     ; Yes, go to write displacement
E238 CD FD 00    4 81 Realloc_9           call    StrWrChar-START             ; Write character
E23B 18 30       4 82 jr      Next                        ; Skip to next character
E23D             4 83 ; Encountered a plus sign so expecting to show a displacement
E23D             4 84 Plus:
E23D             4 85 iDisOpStr:
E23D 3E 00       4 86 ld      a, $00                      ; Get instruction string
E23F FE 1E       4 87 cp      kDisJP                      ; JP instruction?
E241 20 07       4 88 jr      nz, Displace                ; No, so go show displacement
E243 3E 29       4 89 ld      a, ')'                      ; Yes, so just terminate with ')'
E245 CD FD 00    4 90 Realloc_10          call    StrWrChar-START             ; Write close bracket character
E248 18 28       4 91 jr      Exit
E24A             4 92 ; Show displacement in (IX+...) and (IY+...) instructions
E24A             4 93 Displace:
E24A FD 7E 02    4 94 ld      a, (iy+2)                   ; Get index instruction displacement
E24D FE 80       4 95 cp      $80                         ; Is it signed?
E24F 30 05       4 96 jr      nc, Signed                  ; Yes, negate index instruction displacement
E251 08          4 97 ex      af, af'                     ; Store unsigned index instruction displacement
E252 3E 2B       4 98 ld      a, '+'                      ; set '+' for unsigned
E254 18 05       4 99 jr      Convert
E256             4 100 Signed:
E256 ED 44       4 101 neg                                 ; Negate index instruction displacement
E258 08          4 102 ex      af, af'                     ; Store signed index instruction displacement
E259 3E 2D       4 103 ld      a, '-'                      ; set '-' for signed
E25B             4 104 Convert:
E25B CD FD 00    4 105 Realloc_11          call    StrWrChar-START             ; Write plus or minus
E25E 3E 24       4 106 ld      a, '$'                      ; Write '$'
E260 CD FD 00    4 107 Realloc_12          call    StrWrChar-START
E263 08          4 108 ex      af, af'                     ; Restore index instruction displacement
E264 CD EC 00    4 109 Realloc_13          call    StrWrHexByte-START          ; Write index instruction displacement
E267 3E 29       4 110 ld      a, ')'
E269 CD FD 00    4 111 Realloc_14          call    StrWrChar-START             ; Write close bracket character
E26C 04          4 112 inc     b                           ; Increment opcode offset
E26D             4 113 ; Consider next character in disassembler string
E26D             4 114 Next:
E26D CB 7E       4 115 bit     7, (hl)                     ; End of string?
E26F 23          4 116 inc     hl                          ; Point to next character
E270 28 BF       4 117 jr      z, Char                     ; No, so go get next character
E272             4 118 Exit:
E272 E1          4 119 pop     hl                          ; Restore HL register
E273 C9          4 120 ret
E274             4 123 ; Disassembler: Write operand to buffer
E274             4 124 ;   On entry: A = Operand string number
E274             4 125 ;             B = Offset to opcode from start of instruction
E274             4 126 ;             C = Primary op-code
E274             4 127 ;             IY = Start address of instruction
E274             4 128 ;   On exit:  A = Unspecified
