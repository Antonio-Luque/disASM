
; File #0: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\disASM.z80asm

8000             0 1 ; **********************************************************************************************************************
8000             0 2 ; **  disASM                                                                                                          **
8000             0 3 ; **                                                                                                                  **
8000             0 4 ; **  Based on Disassembler support from Small Computer Monitor (SCM)                           by Stephen C Cousins  **
8000             0 5 ; **  https://smallcomputercentral.com/small-computer-monitor/small-computer-monitor-v1-0/                            **
8000             0 6 ; **                                                                                                                  **
8000             0 7 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
8000             0 8 ; **********************************************************************************************************************
8000             0 11 START               ORG     $E100                       ; Default address, can be reallocated below the System Variables
E100             0 12 Main:
E100 21 0B 07    0 13 ld      hl, Realloc_Addrs-START     ; HL points to relative address of Realloc_Addrs
E103 09          0 14 add     hl, bc                      ; Move HL to absolute address of reallocation addresses
E104             0 15 ; Avoid 'call Reallocation'

; File #1: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\Reallocation.z80asm

E104             1 1 ; **********************************************************************************************************************
E104             1 2 ; **  Reallocation                                                                        by HiSoft Devpac, (C) 1983  **
E104             1 3 ; **                                                                                                                  **
E104             1 4 ; **  This piece of code has been disassembled from MONS v4.1 and adapted for disASM by Antonio Luque                 **
E104             1 5 ; **********************************************************************************************************************
E104             1 8 ; Reallocate pointers and calls pointed to by the 'Realloc_X' tags
E104             1 9 ;   On entry: HL = address of reallocation addresses (Realloc_Addrs)
E104             1 10 ;             BC = address of program start
E104             1 11 ;   On exit:  BC IX IY I AF' BC' DE' HL' preserved
E104             1 12 Reallocation:
E104 5E          1 13 ld      e, (hl)                     ; DE = relative reallocation address
E105 23          1 14 inc     hl
E106 56          1 15 ld      d, (hl)
E107 23          1 16 inc     hl                          ; Move HL to next relative reallocation address
E108 7A          1 17 ld      a, d                        ; last address?
E109 B3          1 18 or      e
E10A 28 11       1 19 jr      z, Re_Entry                 ; yes, reallocation finished
E10C EB          1 21 ex      de, hl                      ; HL = relative reallocation address
E10D 09          1 22 add     hl, bc                      ; HL points to address parameter of the instr. at 'Realloc_X'
E10E D5          1 23 push    de                          ; Store next relative reallocation address
E10F E5          1 24 push    hl                          ; Store pointer to address parameter of the instruction
E110 5E          1 25 ld      e, (hl)                     ; Save the content of the address parameter in DE
E111 23          1 26 inc     hl
E112 56          1 27 ld      d, (hl)
E113 EB          1 28 ex      de, hl                      ; Calculate absolute address in HL
E114 09          1 29 add     hl, bc
E115 EB          1 30 ex      de, hl                      ; DE = absolute address parameter of the instruction
E116 E1          1 31 pop     hl                          ; Restore pointer to address parameter of the instruction
E117 73          1 32 ld      (hl), e                     ; Update address parameter of the instruction with calculated
E118 23          1 33 inc     hl                          ;   absolute address
E119 72          1 34 ld      (hl), d
E11A E1          1 35 pop     hl                          ; Restore next relative reallocation address
E11B 18 E7       1 36 jr      Reallocation                ; Repeat again
E11D             1 38 ; From this point on, all address parameters of the instructions pointed to by the 'Realloc_X' tags
E11D             1 39 ;  have been updated with the corresponding absolute address.
E11D             1 41 Re_Entry:
E11D             1 42 ; Put 'JP Init' at the start of program for the re-entry
E11D 3E C3       1 43 ld      a, $C3                      ; 'JP' opcode
E11F 32 00 00    1 44 Realloc_A           ld      ($0000), a                  ; Put it at program start
E122 21 28 00    1 45 Realloc_B           ld      hl, Init-START              ; HL points to Init
E125 22 01 00    1 46 Realloc_C           ld      ($0001), hl                 ; Put Init address as parameter of JP instruction

; File #0: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\disASM.z80asm

E128             0 18 ; Re-entry of program after first execution
E128             0 19 Init:
E128 21 7D 07    0 20 ld      hl, END-START               ; HL points to relative address of stack address
E12B 09          0 21 add     hl, bc                      ; Move HL to absolute address of stack addresses
E12C F9          0 22 ld      sp, hl                      ; Move stack at bottom of Realloc_Addrs
E12D CD 49 00    0 23 Realloc_1           call    InputAddresses-START        ; Input "from" and "to" addresses from keyboard
E130             0 25 ; Disassembly loop
E130             0 26 DisInstruction:
E130 C5          0 27 push    bc                          ; Store "to"+1 address
E131 D5          0 28 push    de                          ; Store string buffer address
E132 CD 28 02    0 30 Realloc_2           call    DisWrInstruction-START      ; Write fully disassembly instruction in buffer
E135 11 0B 07    0 31 Realloc_3           ld      de, kStrBuffer-START        ; DE points to string buffer
E138 1A          0 32 ld      a, (de)                     ; Get string length
E139 47          0 33 ld      b, a                        ; B = length of the string
E13A             0 34 Print_Loop:
E13A 13          0 35 inc     de                          ; Move DE to next character of the string
E13B 1A          0 36 ld      a, (de)                     ; Get character from buffer
E13C D7          0 37 rst     $10                         ; Print character
E13D 10 FB       0 38 djnz    Print_Loop                  ; Loop until end of string
E13F D1          0 40 pop     de                          ; Restore string buffer address
E140 C1          0 41 pop     bc                          ; Restore "to"+1 address
E141 A7          0 43 and     a                           ; reset carry flag
E142 ED 42       0 44 sbc     hl, bc                      ; check if reach "to"+1 address
E144 09          0 45 add     hl, bc
E145 38 E9       0 46 jr      c, DisInstruction           ; loop until reach "to"+1 address
E147             0 48 ; Return to BASIC: "0 OK, "
E147 CF          0 49 rst     $08
E148 FF          0 50 DEFB    $FF
E149             0 53 ; Support routines and data

; File #2: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\IOSupport.z80asm

E149             2 1 ; **********************************************************************************************************************
E149             2 2 ; **  Input/Output support                                                                          by Antonio Luque  **
E149             2 3 ; **********************************************************************************************************************
E149             2 6 ; ROM routines and system variables
E149             2 7 CLS_LOWER           EQU     $0D6E                       ; Clear the lower part of the display
E149             2 8 CL_ALL              EQU     $0DAF                       ; Clear the whole display area
E149             2 9 CHAN_OPEN           EQU     $1601                       ; Open channel subroutine
E149             2 10 PR_STRING           EQU     $203C                       ; Print string
E149             2 11 LAST_K              EQU     $5C08                       ; Last key pressed
E149             2 13 ; Control characters
E149             2 14 CHR_LEFT            EQU     $08                         ; Move cursor backwards
E149             2 15 CHR_DELETE          EQU     $0C                         ; Delete
E149             2 16 CHR_FLASH           EQU     $12                         ; Flash attribute
E149             2 19 ; IOSupport: Input "from" and "to" addresses from keyboard
E149             2 20 ;  On entry: -
E149             2 21 ;  On exit:  HL = Start of instruction to be disassembled ("from")
E149             2 22 ;            BC = End of instrucction to be disassembled ("to"+1)
E149             2 23 ;            DE = Start of string buffer
E149             2 24 ;            IX IY I AF' preserved
E149             2 25 ; Adapted from MONS v4.1 by HiSoft Devpac, (C) 1983
E149             2 26 InputAddresses:
E149 CD 6E 0D    2 27 call    CLS_LOWER                   ; Clear the lower part of the display
E14C FD CB 30 5E 2 29 bit     3, (iy+48)                  ; Query CAPS LOCK flag (FLAGS2 system variable)
E150 F5          2 30 push    af                          ; Store flags to maintain status
E151 FD CB 30 DE 2 31 set     3, (iy+48)                  ; Set CAPS LOCK (FLAGS2 system variable)
E155 11 FD 06    2 33 Realloc_4           ld      de, StrLabels-START         ; DE points to "from" string
E158 06 02       2 34 ld      b, 2                        ; Number of inputs: "from" and "to" (loop counter)
E15A             2 35 Print_Label:
E15A C5          2 36 push    bc                          ; Store current number of inputs
E15B 01 07 00    2 37 ld      bc, 7                       ; Length of string
E15E CD 3C 20    2 38 call    PR_STRING                   ; Print string
E161 D5          2 39 push    de                          ; Store next string pointer
E162 0C          2 40 inc     c                           ; Set C = 0 (current number of nibbles)
E163             2 41 Get_Address:
E163 3E 12       2 42 ld      a, CHR_FLASH                ; Activate flash attribute
E165 D7          2 43 rst     $10
E166 3E 01       2 44 ld      a, 1
E168 D7          2 45 rst     $10
E169 3E 43       2 46 ld      a, 'C'                      ; Print 'C' cursor
E16B D7          2 47 rst     $10
E16C 3E 12       2 48 ld      a, CHR_FLASH                ; Deactivate flash attribute
E16E D7          2 49 rst     $10
E16F AF          2 50 xor     a
E170 D7          2 51 rst     $10
E171 FD CB 01 AE 2 52 res     5, (iy+1)                   ; Set key pressed flag = off
E175             2 53 Wait_Key:
E175 FD CB 01 6E 2 54 bit     5, (iy+1)                   ; Key pressed?
E179 28 FA       2 55 jr      z, Wait_Key                 ; No, repeat until key pressed
E17B 3E 08       2 56 ld      a, CHR_LEFT                 ; Move cursor left
E17D D7          2 57 rst     $10
E17E 3A 08 5C    2 58 ld      a, (LAST_K)                 ; Get ASCII code of key pressed
E181 FE 0C       2 59 cp      CHR_DELETE                  ; Is it Delete?
E183 28 35       2 60 jr      z, Delete                   ; Yes, perform deleting of previous character
E185 FE 30       2 61 cp      '0'                         ; Is it < '0' ?
E187 38 DA       2 62 jr      c, Get_Address              ; Yes, repeat key input
E189 FE 47       2 63 cp      'G'                         ; Is it >= 'G' ?
E18B 30 D6       2 64 jr      nc, Get_Address             ; Yes, repeat key input
E18D FE 3A       2 65 cp      ':'                         ; Is it < ':' ?
E18F 38 04       2 66 jr      c, Input_OK                 ; Yes, perform key input
E191 FE 41       2 67 cp      'A'                         ; Is it < 'A' ?
E193 38 CE       2 68 jr      c, Get_Address              ; Yes, repeat key input
E195             2 70 ; ASCII code is between '0' and '9' or between 'A' and 'F'
E195             2 71 Input_OK:
E195 D7          2 72 rst     $10                         ; Print ASCII code
E196 3A 08 5C    2 73 ld      a, (LAST_K)                 ; Get ASCII code of key pressed in A
E199 D6 30       2 74 sub     '0'                         ; Convert ASCII to decimal number range
E19B FE 0A       2 75 cp      10                          ; Is it in range 0..9 ?
E19D 38 02       2 76 jr      c, High_Nibble              ; Yes, perform high nibble
E19F D6 07       2 77 sub     'A'-'0'-10                  ; No, convert to range A..F
E1A1             2 78 High_Nibble:
E1A1 0C          2 79 inc     c                           ; Increment current number of nibbles
E1A2 CB 41       2 80 bit     0, c                        ; Check if number of nibbles is odd or even 
E1A4 28 05       2 81 jr      z, Low_Nibble               ; If odd, perform low nibble
E1A6 87          2 82 add     a, a                        ; Multiply number by 16
E1A7 87          2 83 add     a, a
E1A8 87          2 84 add     a, a
E1A9 87          2 85 add     a, a
E1AA 47          2 86 ld      b, a                        ; Save high nibble in B
E1AB             2 87 Low_Nibble:
E1AB B0          2 88 or      b                           ; Bitwise OR with high nibble (get byte)
E1AC 47          2 89 ld      b, a                        ; Save byte in B
E1AD 79          2 90 ld      a, c                        ; Get current number of nibbles
E1AE FE 04       2 91 cp      4                           ; Is it 4 ?
E1B0 28 1F       2 92 jr      z, Next_Address             ; Yes, prepare for next address
E1B2 1F          2 93 rra                                 ; Is it odd ?
E1B3 38 AE       2 94 jr      c, Get_Address              ; Yes, continue with next nibble
E1B5 60          2 95 ld      h, b                        ; Store high byte of address in H
E1B6 06 00       2 96 ld      b, 0                        ; Reset high nibble
E1B8 18 A9       2 97 jr      Get_Address                 ; Continue with next nibble
E1BA             2 98 ; Delete key pressed
E1BA             2 99 Delete:
E1BA 79          2 100 ld      a, c                        ; Get current number of nibbles
E1BB B7          2 101 or      a                           ; Is it = 0 ?
E1BC 28 A5       2 102 jr      z, Get_Address              ; Yes, nothing to delete
E1BE 1F          2 103 rra                                 ; Is it odd ?
E1BF 38 04       2 104 jr      c, Cursor_Left              ; Yes, move cursor left
E1C1 7C          2 105 ld      a, h                        ; If even, recover previous byte from H
E1C2 E6 F0       2 106 and     %11110000                   ;  and store high nibble in B
E1C4 47          2 107 ld      b, a
E1C5             2 108 Cursor_Left:
E1C5 0D          2 109 dec     c                           ; Decrement number of nibbles
E1C6 3E 20       2 110 ld      a, ' '                      ; Print space (delete character)
E1C8 D7          2 111 rst     $10
E1C9 3E 08       2 112 ld      a, CHR_LEFT                 ; Move cursor left two times
E1CB D7          2 113 rst     $10
E1CC 3E 08       2 114 ld      a, CHR_LEFT
E1CE D7          2 115 rst     $10
E1CF 18 92       2 116 jr      Get_Address                 ; Continue with next nibble
E1D1             2 117 ; Store "from" address and prepare input of "to" address
E1D1             2 118 Next_Address:
E1D1 68          2 119 ld      l, b                        ; Store low byte of address in L
E1D2 D9          2 120 exx                                 ; Store address in HL'
E1D3 D1          2 121 pop     de                          ; Restore next string pointer
E1D4 C1          2 122 pop     bc                          ; Restore current number of inputs
E1D5 10 83       2 123 djnz    Print_Label                 ; Repeat for each address
E1D7             2 125 ; The "from" and "to" addresses are in HL and HL' respectively
E1D7 D9          2 126 exx                                 ; HL = "to" address, HL' = "from" address
E1D8 E5          2 127 push    hl                          ; Store "to" address
E1D9 CD AF 0D    2 128 call    CL_ALL                      ; Clear display area
E1DC D9          2 129 exx                                 ; HL = "from" address
E1DD C1          2 130 pop     bc                          ; Restore "to" address in BC
E1DE 03          2 131 inc     bc                          ; Increment "to" address
E1DF             2 133 ; Maintain CAPS LOCK status
E1DF F1          2 134 pop     af                          ; Restore flags
E1E0 C0          2 135 ret     nz                          ; If CAPS LOCK is set, return 
E1E1 FD CB 30 9E 2 136 res     3, (iy+48)                  ; Reset CAPS LOCK (FLAGS2 system variable)
E1E5 C9          2 137 ret

; File #3: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\Strings.z80asm

E1E6             3 1 ; **********************************************************************************************************************
E1E6             3 2 ; **  String support                                                                            by Stephen C Cousins  **
E1E6             3 3 ; **                                                                                                                  **
E1E6             3 4 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
E1E6             3 5 ; **********************************************************************************************************************
E1E6             3 8 ; String: Write hex word to string buffer
E1E6             3 9 ;   On entry: DE = Hex word
E1E6             3 10 ;   On exit:  B DE HL IX IY I AF' BC' DE' HL' preserved
E1E6             3 11 StrWrHexWord:
E1E6 7A          3 12 ld      a, d                        ; Get hi byte
E1E7 CD EB 00    3 13 Realloc_5           call    StrWrHexByte-START          ; Write as two hex digits
E1EA 7B          3 14 ld      a, e                        ; Get lo byte
E1EB             3 15 ; String: Write hex byte to string buffer
E1EB             3 16 ;   On entry: A = Hex byte
E1EB             3 17 ;   On exit:  B DE HL IX IY I AF' BC' DE' HL' preserved
E1EB             3 18 StrWrHexByte:
E1EB 4F          3 19 ld      c, a                        ; Save byte to convert
E1EC 1F          3 20 rra                                 ; Shift top nibble to
E1ED 1F          3 21 rra                                 ;  botom four bits..
E1EE 1F          3 22 rra
E1EF 1F          3 23 rra
E1F0 CD F4 00    3 24 Realloc_6           call    StrWrHexNibble-START        ; Write top nibble
E1F3 79          3 25 ld      a, c                        ; Restore byte to convert
E1F4             3 26 ; String: Write hex nibble to string buffer
E1F4             3 27 ;   On entry: A = Hex nibble
E1F4             3 28 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E1F4             3 29 ; https://wikiti.brandonw.net/index.php?title=Z80_Optimization#DAA_trick
E1F4             3 30 StrWrHexNibble:
E1F4 E6 0F       3 31 and     %00001111                   ; Mask off unwanted bits
E1F6 FE 0A       3 32 cp      10                          ; if (nibble < 10) then (carry = on)
E1F8 3F          3 33 ccf                                 ; invert carry
E1F9 CE 30       3 34 adc     a, '0'                      ; A = nibble + ('0' or '1')
E1FB 27          3 35 daa                                 ; convert nibble to ASCII
E1FC             3 36 ; String: Write character
E1FC             3 37 ;   On entry: A = Character to write to string buffer
E1FC             3 38 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E1FC             3 39 ; The specified character is writted to the string buffer and a null
E1FC             3 40 ; terminator added.
E1FC             3 41 StrWrChar:
E1FC E5          3 42 push    hl                          ; Store HL register
E1FD             3 43 iStrStart:
E1FD 21 00 00    3 44 ld      hl, $0000                   ; HL points to current empty position of the string
E200 77          3 45 ld      (hl), a                     ; Store character at string position
E201 23          3 46 inc     hl                          ; Move HL to next empty position
E202 22 FE 00    3 47 Realloc_7           ld      (iStrStart-START+1), hl     ; Update pointer to current empty position
E205 E1          3 48 pop     hl                          ; Restore HL register
E206 C9          3 49 ret

; File #4: C:\Users\Antonio\source\repos\disASM\Z80CodeFiles\DisSupport.z80asm

E207             4 1 ; **********************************************************************************************************************
E207             4 2 ; **  Disassembler support                                                                      by Stephen C Cousins  **
E207             4 3 ; **                                                                                                                  **
E207             4 4 ; **  Adapted for ZX Spectrum disASM                                                                by Antonio Luque  **
E207             4 5 ; **********************************************************************************************************************
E207             4 8 kDisBrack:          EQU     5                           ; Bracket flag
E207             4 9 kDisImmed:          EQU     4                           ; Immediate value flag
E207             4 10 kDisWord:           EQU     3                           ; Immediate value is word (not byte) flag
E207             4 11 kDisLength:         EQU     2                           ; Substite two characters (not one) flag
E207             4 12 kDisMask:           EQU     3                           ; Mask type 0=0x07,1=0x18,2=0x30,3=0x38
E207             4 13 kDisSubsL:          EQU     $0D                         ; Last operand substitution string
E207             4 14 kDisBracHL:         EQU     $15                         ; Bracketed HL
E207             4 15 kDisHL:             EQU     $18                         ; Operation string 'HL'
E207             4 16 kDisJR:             EQU     $1B                         ; Operation string 'JR'
E207             4 17 kDisDJNZ:           EQU     $1C                         ; Operation string 'DJNZ'
E207             4 18 kDisJP:             EQU     $1E                         ; Operation string 'JP'
E207             4 19 kDisH               EQU     $6E                         ; Operation string 'H'
E207             4 20 kDisL               EQU     $71                         ; Operation string 'L'
E207             4 21 kDisOpMask:         EQU     $3F                         ; Operand 1 mask to exclude pre-code bits
E207             4 23 ; Control characters
E207             4 24 CHR_ENTER           EQU     $0D
E207             4 26 ; Disassembler: Write character to string buffer
E207             4 27 ;   On entry: A = Character to write
E207             4 28 ;   On exit:  BC DE HL IX IY I AF' BC' DE' HL' preserved
E207             4 29 ; This version of write character removes bit 7 (the new string flag)
E207             4 30 ; and replaces "-" with "(HL)"
E207             4 31 DisWrChar:
E207 E6 7F       4 32 and     %01111111                   ; Mask off bit 7 (string start bit)
E209 FE 2D       4 33 cp      '-'                         ; Code for "(HL)" ?
E20B 20 EF       4 34 jr      nz, StrWrChar               ; No, print character
E20D 3E 15       4 36 ld      a, kDisBracHL               ; String number for "(HL)"
E20F             4 37 ; Write disassembler string
E20F             4 38 ;   On entry: A = Disassembler data string number
E20F             4 39 ;             B = Offset to current opcode from start of instruction
E20F             4 40 ;             IY = Start address for current instruction
E20F             4 41 ;   On exit:  C DE HL IX IY I AF' BC' DE' HL' preserved
E20F             4 42 ;             B is incremented if (IX/IY+d) is substituted
E20F             4 43 ; This version of write string removes bit 7 (the new string flag)
E20F             4 44 ; If iDisTmp1 (the current index instruction opcode) is 0xDD or 0xFD, 
E20F             4 45 ; is not zero then strings are replaced: 
E20F             4 46 ;   HL is replaced with IX or IY
E20F             4 47 ;   (HL) is replaced with (IX + d) or (IY + d) except for JP instruction
E20F             4 48 ;   where is is just replaced by (IX) or (IY)
E20F             4 49 DisWrString:
E20F E5          4 50 push    hl                          ; Store HL register
E210 6F          4 52 ld      l, a                        ; Store string number
E211 FE 6E       4 53 cp      kDisH                       ; String = H ?
E213 28 0C       4 54 jr      z, Subs                     ; Yes, so go do substitution
E215 FE 71       4 55 cp      kDisL                       ; String = L ?
E217 28 08       4 56 jr      z, Subs                     ; Yes, so go do substitution
E219 FE 15       4 57 cp      kDisBracHL                  ; String = (HL) ?
E21B 28 04       4 58 jr      z, Subs                     ; Yes, so go do substitution
E21D FE 18       4 59 cp      kDisHL                      ; String = HL ?
E21F 20 0B       4 60 jr      nz, GotString               ; No, so just write the string
E221             4 61 ; Substitute IX/IY in HL string or (IX/IY+d) in (HL) string
E221             4 62 Subs:
E221             4 63 iDisIndex:
E221 3E 00       4 64 ld      a, $00                      ; Get index instruction opcode
E223 B7          4 65 or      a                           ; Index instruction?
E224 28 06       4 66 jr      z, GotString                ; No, so skip substitutions
E226 2C          4 67 inc     l                           ; Increment to IX string number
E227 FE DD       4 68 cp      $DD                         ; IX instruction?
E229 28 01       4 69 jr      z, GotString                ; Yes, so go write it
E22B 2C          4 70 inc     l                           ; Increment to IY string
E22C             4 71 GotString:
E22C 7D          4 72 ld      a, l                        ; Get string number
E22D CD 32 03    4 73 Realloc_8           call    FindStringInList-START      ; Find start of string A
E230             4 75 ; HL now points to disassembler string
E230             4 76 Char:
E230 7E          4 77 ld      a, (hl)                     ; Get character from string
E231 E6 7F       4 78 and     %01111111                   ; Mask off string end bit
E233 FE 2B       4 79 cp      '+'                         ; Is it a '+' sign (displacement) ?
E235 28 05       4 80 jr      z, Plus                     ; Yes, go to write displacement
E237 CD FC 00    4 81 Realloc_9           call    StrWrChar-START             ; Write character
E23A 18 30       4 82 jr      Next                        ; Skip to next character
E23C             4 83 ; Encountered a plus sign so expecting to show a displacement
E23C             4 84 Plus:
E23C             4 85 iDisOpStr:
E23C 3E 00       4 86 ld      a, $00                      ; Get instruction string
E23E FE 1E       4 87 cp      kDisJP                      ; JP instruction?
E240 20 07       4 88 jr      nz, Displace                ; No, so go show displacement
E242 3E 29       4 89 ld      a, ')'                      ; Yes, so just terminate with ')'
E244 CD FC 00    4 90 Realloc_10          call    StrWrChar-START             ; Write close bracket character
E247 18 28       4 91 jr      Exit
E249             4 92 ; Show displacement in (IX+...) and (IY+...) instructions
E249             4 93 Displace:
E249 FD 7E 02    4 94 ld      a, (iy+2)                   ; Get index instruction displacement
E24C FE 80       4 95 cp      $80                         ; Is it signed?
E24E 30 05       4 96 jr      nc, Signed                  ; Yes, negate index instruction displacement
E250 08          4 97 ex      af, af'                     ; Store unsigned index instruction displacement
E251 3E 2B       4 98 ld      a, '+'                      ; set '+' for unsigned
E253 18 05       4 99 jr      Convert
E255             4 100 Signed:
E255 ED 44       4 101 neg                                 ; Negate index instruction displacement
E257 08          4 102 ex      af, af'                     ; Store signed index instruction displacement
E258 3E 2D       4 103 ld      a, '-'                      ; set '-' for signed
E25A             4 104 Convert:
E25A CD FC 00    4 105 Realloc_11          call    StrWrChar-START             ; Write plus or minus
E25D 3E 24       4 106 ld      a, '$'                      ; Write '$'
E25F CD FC 00    4 107 Realloc_12          call    StrWrChar-START
E262 08          4 108 ex      af, af'                     ; Restore index instruction displacement
E263 CD EB 00    4 109 Realloc_13          call    StrWrHexByte-START          ; Write index instruction displacement
E266 3E 29       4 110 ld      a, ')'
E268 CD FC 00    4 111 Realloc_14          call    StrWrChar-START             ; Write close bracket character
E26B 04          4 112 inc     b                           ; Increment opcode offset
E26C             4 113 ; Consider next character in disassembler string
E26C             4 114 Next:
E26C CB 7E       4 115 bit     7, (hl)                     ; End of string?
E26E 23          4 116 inc     hl                          ; Point to next character
E26F 28 BF       4 117 jr      z, Char                     ; No, so go get next character
E271             4 118 Exit:
E271 E1          4 119 pop     hl                          ; Restore HL register
E272 C9          4 120 ret
E273             4 123 ; Disassembler: Write operand to buffer
E273             4 124 ;   On entry: A = Operand string number
E273             4 125 ;             B = Offset to opcode from start of instruction
E273             4 126 ;             C = Primary op-code
